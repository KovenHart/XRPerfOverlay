<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- S'exécute aussi sur un runtime .NET plus récent (9, 10...) si le 8 n'est pas installé. -->
    <RollForward>LatestMajor</RollForward>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>XRPerfSensors</AssemblyName>
    <RootNamespace>XRPerfSensors</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Icône du fichier .exe dans l'Explorateur et la barre des tâches (dessinée par tools/gen_icon.py). -->
    <ApplicationIcon>XRPerfSensors.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Numéro de version : le même que la layer, lu dans le fichier VERSION à la racine du projet. -->
  <PropertyGroup Condition="Exists('$(MSBuildThisFileDirectory)..\VERSION')">
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\VERSION').Trim())</Version>
    <Product>XR Perf Overlay</Product>
    <!-- Pas d'identifiant de commit ajouté au numéro affiché. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>

  <ItemGroup>
    <!-- La même icône, lisible par le programme : zone de notification et fenêtre du bureau. -->
    <EmbeddedResource Include="XRPerfSensors.ico" LogicalName="XRPerfSensors.ico" />
  </ItemGroup>

</Project>
